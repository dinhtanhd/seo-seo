location @tram_domain_denied { return 421; }

# Fallback bypasses /index.php's cache rewrites, including a failed PHP file read.
location @tram_public_html_cache_miss {
    # Laravel resolves the current host and site when the cached file cannot be served.
@CACHE_AUTH_OFF@
    include /www/server/nginx/conf/fastcgi_params;
    fastcgi_param HTTPS $https if_not_empty;
    fastcgi_param SCRIPT_FILENAME @ROOT@/application/public/index.php;
    fastcgi_param SCRIPT_NAME /index.php;
    fastcgi_param HTTP_PROXY "";
    fastcgi_param ADMIN_HOSTS @DOMAIN@;
    fastcgi_param TRAM_PUBLIC_CACHE_ELIGIBLE $tram_public_cache_eligible;
    fastcgi_pass @PHP_UPSTREAM@;
    fastcgi_read_timeout 65s;
}

location = /__tram_public_html_cache {
    internal;
    root @ROOT@/application/storage/app/public-html;
    error_page 418 = /__tram_public_runtime_html_cache;
    @CACHE_ADVERTISING_REDIRECTS@
    error_page 403 =421 @tram_domain_denied;
    if (-f $document_root$tram_public_runtime_advertising_cache_file) { return 420; }
    if (-f $document_root$tram_public_advertising_cache_file) { return 419; }
    if (-f $document_root$tram_public_runtime_cache_file) { return 418; }
    try_files $tram_public_cache_file @tram_public_html_cache_miss;
    fastcgi_intercept_errors on;
    error_page 404 = @tram_public_html_cache_miss;
    include /www/server/nginx/conf/fastcgi_params;
    fastcgi_param HTTPS $https if_not_empty;
    fastcgi_param SCRIPT_FILENAME @ROOT@/application/bootstrap/serve-html-cache.php;
    fastcgi_param HTTP_PROXY "";
    fastcgi_param ADMIN_HOSTS @DOMAIN@;
    fastcgi_param TRAM_PUBLIC_HTML_CACHE_REQUEST 1;
    fastcgi_param TRAM_PUBLIC_HTML_CACHE_ROOT $document_root;
    fastcgi_param TRAM_PUBLIC_HTML_CACHE_DATABASE $tram_cache_database;
    fastcgi_param TRAM_PUBLIC_HTML_CACHE_HOST $host;
    fastcgi_param TRAM_PUBLIC_HTML_CACHE_FILE $tram_public_cache_file;
    fastcgi_pass @PHP_UPSTREAM@;
    fastcgi_read_timeout 65s;
    types { }
    default_type text/html;
    charset utf-8;
    sendfile on;
    open_file_cache off;
    etag off;
    if_modified_since off;
    max_ranges 0;
    add_header Cache-Control no-store always;
    add_header Vary User-Agent always;
    add_header X-Tram-Cache HIT;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Strict-Transport-Security $tram_public_hsts always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' https: data:; media-src 'self' https:; style-src 'self' 'unsafe-inline'; script-src 'none'; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'self'" always;
}

